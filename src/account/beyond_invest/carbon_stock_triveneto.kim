3558, -25.3735415 36.8210352, -26.0638875 37.7269566, -26.0876455 37.8813266, -25.9586885 38.0606216, -25.7884815 38.1094936, -25.1366565 38.0583966, -24.9112795 37.9213016, -24.5317463 37.2416209, -24.8295809 36.7937806, -25.0421406 36.7273558)), ((-29.0939805 38.6197546, -28.9559995 38.7777996, -28.2955105 38.9591686, -28.3024535 39.1698486, -28.0364775 39.3075316, -27.8386205 39.2526506, -27.6991835 39.1064176, -27.7026855 38.9201576, -27.8780655 38.8106386, -27.6415515 38.7177676, -27.5409915 38.9370586, -27.2285215 39.0041786, -26.8848745 38.9023576, -26.7598055 38.6947136, -26.8499305 38.5223226, -27.0124855 38.4240776, -27.5081055 38.5165616, -27.5931945 38.3874516, -27.8987155 38.2356446, -28.2365375 38.1785266, -28.5255935 38.1945996, -28.8930805 38.3509096, -29.0579085 38.4922736, -29.0939805 38.6197546)), ((-31.5429324 39.5091025, -31.2439582 39.901676, -31.0270979 39.914529, -30.8663033 39.7846578, -30.8636385 39.377891, -31.0439862 39.181234, -31.4216604 39.1960297, -31.5399992 39.3499376, -31.5429324 39.5091025)))");


@intensive(space)
model chemistry:Carbon im:Mass in t/ha
	observing
	chemistry:Carbon AboveGround im:Mass in t/ha named above_ground_carbon,
	chemistry:Carbon BelowGround im:Mass in t/ha named below_ground_carbon,
	soil:Soil chemistry:Organic chemistry:Carbon im:Mass in t/ha named soil_carbon,
	chemistry:Organic chemistry:Carbon im:Mass caused by ecology.incubation:Litterfall in t/ha named dead_organic_matter_carbon
set to [above_ground_carbon + below_ground_carbon + soil_carbon + dead_organic_matter_carbon];
	//over space(urn='local:justus.muhando:im.data.global:im-data-global-geography_triveneto_boundary_epsg4326');

