private namespace account.beyond_invest.carbon_stock_triveneto
using nca.landuse.ipcc, nca.ecology.ipcc;

abstract attribute GroundRelativePosition
    "Describes the vertical placement of a physical entity relative to the Earth's soil surface."
    has disjoint children
        (AboveGround
            "Located entirely or primarily on or above the soil surface."
        ),
        (BelowGround
            "Located entirely or primarily beneath the soil surface."
        );

// Could go in ecology
mass AboveGroundBiomass
    "The total mass of living biological organisms located above the soil surface in a given area."
    is AboveGround biology:Biomass within ecology:Vegetation earth:Region;
//    is earth:AboveGround biology:Biomass within ecology:Vegetation earth:Region;

mass BelowGroundBiomass
    "The total mass of living biological organisms (typically roots) located beneath the soil surface."
    is BelowGround biology:Biomass within ecology:Vegetation earth:Region;

// -----------------------------------------------------------------------------
// NON-SOIL CARBON POOLS FOR THE CURRENT ARIES FORMULATION
//
// The table contains c_above, c_below and c_dead only.
// Soil organic carbon is deliberately NOT included here.
// It is supplied independently by the spatial SoilGrids SOC stock layer
// (0-30 cm, t C/ha, 250 m).
//
// Forest non-soil coefficients retain explicit variation by:
// LULC type × forest age/status × climatic zone.
//
// For non-forest classes, climate is retained in the lookup structure even
// where coefficients are identical across climates, to preserve the current
// operational structure and facilitate review.
//
// c_dead represents dead organic matter carbon:
// c_dead = litter carbon + dead wood carbon.
// -----------------------------------------------------------------------------    
define TRIVENETO_CARBON_POOLS_TABLE as {{
  landcover                      | forest_type                           | ipcc_climatic_region         	 | c_above | c_below | c_dead
  ---------------------------------------------------------------------------------------------------------------------------------------
  landcover:ConiferousForest     | nca.landuse.ipcc:OldSecondaryForest   | nca.ecology.ipcc:WarmTemperateWet | 72.333  | 14.901  | 27.2   ,
