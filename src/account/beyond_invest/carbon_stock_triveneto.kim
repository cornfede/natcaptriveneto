// -----------------------------------------------------------------------------
// ABOVE-GROUND CARBON STOCK
// c_above from TRIVENETO_CARBON_POOLS_TABLE.
// Output unit: t C/ha.
// -----------------------------------------------------------------------------
@intensive(space)
model chemistry:Carbon AboveGround im:Mass in t/ha
	observing
	landcover:LandCoverType named landcover,
	nca.landuse.ipcc:LandUseType named forest_type, 
	type of nca.ecology.ipcc:ClimaticZone named ipcc_climatic_region
lookup (landcover, forest_type, ipcc_climatic_region, ? , * ,* ) into TRIVENETO_CARBON_POOLS_TABLE;
	//over space(urn='local:justus.muhando:im.data.global:im-data-global-geography_triveneto_boundary_epsg4326');

// -----------------------------------------------------------------------------
// BELOW-GROUND CARBON STOCK
// c_below from TRIVENETO_CARBON_POOLS_TABLE.
// Output unit: t C/ha.
// -----------------------------------------------------------------------------

@intensive(space)
model chemistry:Carbon BelowGround im:Mass in t/ha
	observing
	landcover:LandCoverType named landcover,
	nca.landuse.ipcc:LandUseType named forest_type, 
	type of nca.ecology.ipcc:ClimaticZone named ipcc_climatic_region
lookup (landcover, forest_type, ipcc_climatic_region, * , ? ,* ) into TRIVENETO_CARBON_POOLS_TABLE;
	//over space(urn='local:justus.muhando:im.data.global:im-data-global-geography_triveneto_boundary_epsg4326');

// -----------------------------------------------------------------------------
// DEAD ORGANIC MATTER CARBON POOL (c_dead)
//
// The existing Litterfall-based semantic observable is retained
//
// IMPORTANT:
// The numerical values assigned here do NOT represent litter carbon alone.
// In the Triveneto carbon-pool lookup:
//
//      c_dead = litter carbon + dead-wood carbon
//
// The forest values were derived from IPCC 2019 Vol. 4, Ch. 2, Table 2.2,
// by summing the corresponding litter and dead-wood stocks.
//
// Therefore, this model should be interpreted operationally as the
// dead-organic-matter carbon pool used in the carbon-stock calculation,
// despite the more restrictive Litterfall semantic annotation.
// -----------------------------------------------------------------------------
@intensive(space)
model chemistry:Organic chemistry:Carbon im:Mass caused by ecology.incubation:Litterfall in t/ha
	observing
	landcover:LandCoverType named landcover,
	nca.landuse.ipcc:LandUseType named forest_type, 
	type of nca.ecology.ipcc:ClimaticZone named ipcc_climatic_region
lookup (landcover, forest_type, ipcc_climatic_region, * , * ,? ) into TRIVENETO_CARBON_POOLS_TABLE;
	//over space(urn='local:justus.muhando:im.data.global:im-data-global-geography_triveneto_boundary_epsg4326');



