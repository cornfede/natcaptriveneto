// PROVISIONAL C-FACTOR LOOKUP
// Used only for preliminary testing and comparison.
// Crop values approximate the LANDUM/JRC crop factors after applying
// the average European management multiplier: 1 - 0.191 = 0.809.

define C_FACTOR_TABLE_TRV as {{
	
	    land_cover_type                  | c_factor
	------------------------------------------------
	
	// FORESTS
	// Italian JRC/LANDUM mean forest value.
	landcover:ConiferousForest            | 0.0013,
	landcover:BroadleafForest             | 0.0013,
	
	// ARTIFICIAL AND URBAN CLASSES
	// Mineral extraction retains the previous provisional value.
	landcover:MineralExtraction           | 0.1464,
	landcover:Urban                       | 0,
	
	// Italian natural-grassland value used as a proxy for urban parks.
	landcover:UrbanPark                   | 0.0416,
	
	landcover:WaterBody                   | 0,
	
	// CEREALS
	// Wheat: 0.20 * 0.809
	landcover:Wheat                       | 0.1618,
	
	// Proxy based on the mean of barley and other common cereals:
	// approximately 0.205 * 0.809
	landcover:Cereals                     | 0.1658,
	
	// Maize: 0.38 * 0.809
	landcover:Maize                       | 0.3074,
	
	// Rice: 0.15 * 0.809
	landcover:RiceField                   | 0.1214,
	
	// OTHER ANNUAL CROPS
	// No direct value is provided in the original JRC crop table.
	// Previous general arable-land value retained as proxy.
	landcover:Vegetable                   | 0.2346,
	
	// Dry pulses: 0.32 * 0.809
	landcover:Bean                        | 0.2589,
	
	// Potato: 0.34 * 0.809
	landcover:Potato                      | 0.2751,
	
	// Sugar beet: 0.34 * 0.809
	landcover:Beet                        | 0.2751,
	
	// Mean proxy for sunflower and rapeseed:
	// ((0.32 + 0.30) / 2) * 0.809
	landcover:OilseedLegume               | 0.2508,
	
	// Soybean: 0.28 * 0.809
	landcover:Soybean                     | 0.2265,
	
	// Proxy for the aggregated flax-cotton-hemp class.
	// It is intentionally closer to linseed/hemp than to cotton,
	// because cotton is expected to have a limited role in TRV.
	landcover:Cotton                      | 0.2400,
	
	// GENERAL ARABLE LAND
	// Mean final C-factor for Italian arable land from LANDUM.
	landcover:ArableLand                  | 0.2110,
	
	// GRASSLAND AND PASTURES
	// Italian LANDUM value for natural grassland.
	landcover:Grassland                   | 0.0416,
	
	// Italian LANDUM value for pastures.
	landcover:Pastureland                 | 0.0988,
	
	// PERMANENT CROPS
	// Equal-weight provisional mean of:
	// Italian vineyards 0.3454,
	// fruit/nuts proxy 0.2188,
	// Italian olive groves 0.2163.
	landcover:PermanentCropland           | 0.2500,
	
	// WETLANDS
	// Excluded operationally from sheet and rill erosion.
	landcover:Wetland                     | 0,
	
	// MIXED BARE ROCK / BARE SOIL
	// Italian sparse-vegetation value used as operational proxy.
	landcover:BareArea                    | 0.2509
}};

//For c_factor unvegetated, the original values present in the pyrenees project are kept (TO BE ADPATED TO TRV IF POSSIBLE)
