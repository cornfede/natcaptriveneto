// PROVISIONAL C-FACTOR FOR THE COUNTERFACTUAL
// WITHOUT VEGETATION.
//
// C = 1 is the standard RUSLE bare-soil reference.
// Already non-vegetated or excluded classes retain their actual value
// so that they do not produce a fictitious vegetation-retention service.

define C_FACTOR_TABLE_UNVEGETATED_TRV as {{
	
	    land_cover_type                  | c_factor
	------------------------------------------------
	
	// FORESTS
	landcover:ConiferousForest            | 1,
	landcover:BroadleafForest             | 1,
	
	// ARTIFICIAL AND URBAN CLASSES
	// No vegetation-retention service attributed to mining or settlements.
	landcover:MineralExtraction           | 0.1464,
	landcover:Urban                       | 0,
	
	// Urban parks are treated as vegetated areas.
	landcover:UrbanPark                   | 1,
	
	landcover:WaterBody                   | 0,
	
	// AGRICULTURAL VEGETATION
	landcover:Wheat                       | 1,
	landcover:Cereals                     | 1,
	landcover:Maize                       | 1,
	landcover:RiceField                   | 1,
	landcover:Vegetable                   | 1,
	landcover:Bean                        | 1,
	landcover:Potato                      | 1,
	landcover:Beet                        | 1,
	landcover:OilseedLegume               | 1,
	landcover:Soybean                     | 1,
	landcover:Cotton                      | 1,
	landcover:ArableLand                  | 1,
	
	// GRASSLAND AND PERMANENT CROPS
	landcover:Grassland                   | 1,
	landcover:PermanentCropland           | 1,
	landcover:Pastureland                 | 1,
	
	// EXCLUDED OR ALREADY NON-UPLAND CLASSES
	landcover:Wetland                     | 0,
	
	// The mixed bare-rock/bare-soil class is not considered
	// to provide a vegetation-retention service at this stage.
	landcover:BareArea                    | 0.2509
}};

//The P_FACTOR_TABLE_TRV was also adjusted with the same p_factor values used in the SDR InVEST model (since they were more appropriate for Europe)
//NOTE: THE C AND P FACTORS VALUES TAKEN FROM THE PARALLEL INVEST APPLICATION  ARE VERY DIFFERENT FROM THE GLOBAL ONES ORIGINALLY USED BY THE RUSLE MODEL IN ARIES (WHY? ALSO COMPARE THAT WITH THE MORE LOCAL VALUES OF PYRENEES USED BY THE USPED MODEL)
