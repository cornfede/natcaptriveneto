    landcover:ScrubHerbaceousVegetation				|	GBIF.SPECIES:8016180	|	#					|	0.02	,
    landcover:ScrubHerbaceousVegetation				|	GBIF.SPECIES:5354656	|	#					|	0.15	,
    landcover:ScrubHerbaceousVegetation				|	#						|	#					|	0.08	,
    
