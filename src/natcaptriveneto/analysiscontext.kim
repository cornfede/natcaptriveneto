project private namespace natcaptriveneto.analysiscontext;

// Triveneto AOI
observe earth:Region named trv_aoi    
    over space (urn = 'local:justus.muhando:im.data.global:im-data-global-geography_triveneto_boundary_epsg4326',
                grid= "250 m",
               projection= "EPSG:4326"), 
//         time(start=2018, end=2024, step=1.year);
         time(year=2023);

