project private namespace natcaptriveneto.data
using nca.ecology.ipcc, nca.landuse.ipcc;

// Testing Triveneto 2018 LULC
number 'local:justus.muhando:im.data.global:im-data-global-landcover.triveneto_lulc_sottoclassi_epsg3035_250m_2018'
		as trv_uso_ispra_2018;
// Testing Triveneto 2023 LULC
number 'local:justus.muhando:im.data.global:im-data-global-landcover.triveneto_lulc_sottoclassi_epsg3035_250m_2023'
		as trv_uso_ispra_2023;

model local:justus.muhando:im.data.global:im-data-global-climate.triveneto_zone_clima_250m_epsg3035
	as type of nca.ecology.ipcc:ClimaticZone named ipcc_climatic_region classified into
	nca.ecology.ipcc:WarmTemperateWet if 0,
	nca.ecology.ipcc:WarmTemperateDry if 1,
	nca.ecology.ipcc:ColdTemperateWet if 2,
 	nca.ecology.ipcc:PolarMoist if 3;


// local:justus.muhando:im.data.global:im-data-global-landcover.triveneto_lulc_sottoclassi_epsg3035_250m_2018
model local:justus.muhando:im.data.global:im-data-global-landcover.triveneto_lulc_sottoclassi_epsg3035_250m_2023 
as landcover:LandCoverType classified into
	landcover:ConiferousForest if in (211 212 213),
	landcover:BroadleafForest if in (221 222 223),
	landcover:MineralExtraction if 300,
	landcover:Urban if 401,
	landcover:UrbanPark if 403,
	landcover:WaterBody if 500,
	landcover:Wheat if 1110,
	landcover:Cereals if 1120,
	landcover:Maize if 1130,
	landcover:RiceField if 1140,
	landcover:Vegetable if 1210,
	landcover:DryPulse if 1220,
	landcover:Potato if 1310,
	landcover:Beet if 1320,
	landcover:Sunflower if 1410,
	landcover:Soybean if 1420,
	landcover:Rapeseed if 1430,
	landcover:Cotton if 1440,
	landcover:Grassland if 1500,
	landcover:ArableLand if 1600,
	landcover:PermanentCropland if 2100,
	landcover:Vineyard if 2100,
	landcover:FruitBerryPlantation if 2100,
	landcover:OliveGrove if 2100,
	landcover:NutOrchard if 2100,
	landcover:Pastureland if 3100,
	landcover:Wetland if in (6101 6102),
	landcover:BareRock if 6201;



// local:justus.muhando:im.data.global:im-data-global-landcover.triveneto_lulc_sottoclassi_epsg3035_250m_2018
@colormap(values = {
	nca.landuse.ipcc:OldSecondaryForest: (15 60 15)
	nca.landuse.ipcc:YoungSecondaryForest: (22 92 22)
}) 
model local:justus.muhando:im.data.global:im-data-global-landcover.triveneto_lulc_sottoclassi_epsg3035_250m_2023 
as //type of nca.landuse.ipcc:LandUseType classified into
	nca.landuse.ipcc:LandUseType classified into
	nca.landuse.ipcc:OldSecondaryForest if in (212 221),
	nca.landuse.ipcc:YoungSecondaryForest if in (212 222);	
 
number 
	local:justus.muhando:im.data.global:im-data-global-landcover.triveneto_lulc_sottoclassi_epsg3035_250m_2023 as test;	
                           
model local:justus.muhando:im.data.global:im-data-global-soil.triveneto_soc_stock_t_ha_250m_epsg3035
 as soil:Soil chemistry:Organic chemistry:Carbon im:Mass in t/ha;       
               